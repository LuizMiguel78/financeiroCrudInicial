@model PrjFinanceiro.Models.Cargo

<div class="container mt-5">
    <h2>Novo Cargo</h2>
    <form asp-action="Criar" method="post">
        <div class="mb-3">
            <label for="codigo" class="form-label">Código</label>
            <input type="number" class="form-control" id="codigo" name="codigo" required />
        </div>
        <div class="mb-3">
            <label for="descricao" class="form-label">Descrição</label>
            <input type="text" class="form-control" id="descricao" name="descricao" required />
        </div>
        <div class="mb-3">
            <label for="abreviacao" class="form-label">Abreviação</label>
            <input type="text" class="form-control" id="abreviacao" name="abreviacao" required />
        </div>
        <button type="submit" class="btn btn-success">Salvar</button>
        <a href="/Cargo/Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
