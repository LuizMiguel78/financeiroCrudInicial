@model IEnumerable<PrjFinanceiro.Models.Cargo>

<div class="container mt-5">
    <h2>Lista de Cargos</h2>
    <a href="/Cargo/Criar" class="btn btn-primary mb-3">Novo Cargo</a>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Código</th>
                <th>Descrição</th>
                <th>Abreviação</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Codigo</td>
                    <td>@item.Descricao</td>
                    <td>@item.Abreviacao</td>
                    <td>
                        <a href="/Cargo/Editar/@item.Codigo" class="btn btn-warning btn-sm">Editar</a>
                        <a href="/Cargo/Excluir/@item.Codigo" class="btn btn-danger btn-sm">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
