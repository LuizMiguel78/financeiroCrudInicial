@model PrjFinanceiro.Models.TipoConta

<div class="container mt-5">
    <div class="card">
        <div class="card-header bg-success text-white">
            <h2>Cadastrar Novo Tipo de Conta</h2>
        </div>
        <div class="card-body">
            <form action="/TipoConta/Criar" method="post">

                <div class="form-group mb-3">
                    <label for="codigo">Nome da Conta</label>
                    <input type="text" id="codigo" name="codigo" class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label for="descricao">Descricao</label>
                    <input type="text" id="descricao" name="descricao" class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label for="sigla">Sigla</label>
                    <input type="text" id="sigla" name="sigla" class="form-control" maxlength="2" required />
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary">Salvar TipoConta</button>
                    <a href="/TipoConta/Index" class="btn btn-secondary">Voltar para a Lista</a>
                </div>

            </form>
        </div>
    </div>
</div>