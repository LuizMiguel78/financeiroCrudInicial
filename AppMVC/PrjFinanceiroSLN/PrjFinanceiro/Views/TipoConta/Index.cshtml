@model IEnumerable<PrjFinanceiro.Models.TipoConta>

<div class="container mt-5">
    <h2 class="mb-4">Lista de tipos de contas -  @ViewBag.nomesenaii</h2>

    <p>
        <a href="/TipoConta/Criar" class="btn btn-success">Cadastrar Novo tipo de conta</a>
    </p>

    <table class="table table-bordered table-hover">
        <thead class="thead-dark">
            <tr>
                <th>Código</th>
                <th>Descricao</th>
                <th>Sigla</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>                    
                    <td>@item.Codigo</td>
                    <td>@item.Descricao</td>
                    <td>@item.Sigla</td>
                    <td>
                        <a href="/TipoConta/Editar/@item.Codigo" class="btn btn-sm btn-primary">Editar</a>
                        <a href="/TipoConta/Excluir/@item.Codigo" class="btn btn-sm btn-danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>