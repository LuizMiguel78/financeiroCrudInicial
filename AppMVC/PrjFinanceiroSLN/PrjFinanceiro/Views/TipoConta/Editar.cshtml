@model PrjFinanceiro.Models.TipoConta

<div class="container mt-5">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h2>Editar TipoConta</h2>
        </div>
        <div class="card-body">
            <form action="/TipoConta/Editar" method="post">

                <input type="hidden" name="codigo" value="@Model.Codigo" />

                <div class="form-group mb-3">
                    <label for="codigo">Nome do TipoConta</label>
                    <input type="text" id="codigo" name="codigo" class="form-control" value="@Model.Codigo" required />
                </div>

                <div class="form-group mb-3">
                    <label for="descricao">Descricao</label>
                    <input type="text" id="descricao" name="descricao" class="form-control" value="@Model.Descricao" required />
                </div>

                <div class="form-group mb-3">
                    <label for="sigla">Sigla</label>
                    <input type="text" id="sigla" name="sigla" class="form-control" value="@Model.Sigla" maxlength="4" required />
                </div>

                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary">Salvar Alterações</button>
                    <a href="/TipoConta/Index" class="btn btn-secondary">Cancelar</a>
                </div>

            </form>
        </div>
    </div>
</div>